<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- ==================== 项目基本信息 ==================== -->
    <groupId>com.zbw</groupId>
    <artifactId>demo</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>demo</name>
    <description>springboot-library_manager_system</description>

    <!-- ==================== 全局版本管理 ==================== -->
    <properties>
        <!-- Spring Boot 版本，3.x 对应 JDK 17+ -->
        <spring-boot.version>3.3.2</spring-boot.version>
        <!-- 编译和运行使用的 Java 版本 -->
        <java.version>17</java.version>
        <!-- 项目编码，防止中文乱码 -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <!-- ==================== Spring Boot 版本统一管理 ==================== -->
    <!-- 导入 spring-boot-dependencies 的 BOM，这样大部分依赖都不需要写版本号 -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- ==================== Maven 仓库配置 ==================== -->
    <!-- 优先使用阿里云镜像，下载依赖更快更稳定 -->
    <repositories>
        <repository>
            <id>aliyun</id>
            <name>aliyun</name>
            <url>https://maven.aliyun.com/repository/public</url>
        </repository>
    </repositories>

    <!-- ==================== 项目依赖 ==================== -->
    <dependencies>
        <!-- Lombok：简化 JavaBean 代码，自动生成 getter/setter/构造器等 -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>1.18.38</version>
            <optional>true</optional>
        </dependency>

        <!-- Thymeleaf 模板引擎：用于渲染 HTML 页面 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>

        <!-- Spring Web：提供 Spring MVC 和内置 Tomcat，开发 Web 项目核心 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- MyBatis-Plus 整合 Spring Boot 3.x：用于数据库操作（增强版 MyBatis） -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
            <version>3.5.7</version>
        </dependency>

        <!-- MySQL 驱动：Spring Boot 3 使用 mysql-connector-j 而不是旧的 mysql-connector-java -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>  <!-- 运行时才需要，编译时不强制 -->
        </dependency>

        <!-- 测试框架：包含 JUnit 5、Spring Test 等 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>  <!-- 只在测试阶段使用 -->
        </dependency>

        <!-- 热部署工具：修改代码后自动重启，方便开发调试 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <optional>true</optional>  <!-- 打包时不会包含 -->
        </dependency>

        <!-- Apache POI：用于Excel文件的读取和写入 -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>5.2.5</version>
        </dependency>

        <!-- Spring Security Crypto：提供 BCrypt 密码加密，不引入完整的 Spring Security -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>

        <!-- Spring Boot Validation：后端参数校验（@Valid, @NotBlank 等） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

    </dependencies>

    <!-- ==================== 构建配置 ==================== -->
    <build>
        <plugins>
            <!-- Maven 编译插件：指定 Java 版本，并保留方法参数名（Spring 需要） -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <!-- 源代码 Java 版本 -->
                    <source>17</source>
                    <!-- 编译后的字节码版本 -->
                    <target>17</target>
                    <!-- 保留方法参数名，这样 Controller 的 @RequestParam 可以不写 value -->
                    <parameters>true</parameters>
                    <!-- 统一编码 -->
                    <encoding>UTF-8</encoding>
                    <!-- 显式配置 Lombok 注解处理器，确保跨 JDK 版本兼容 -->
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>1.18.38</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>

            <!-- Spring Boot 打包插件：可以将项目打包成可执行的 jar 包 -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring-boot.version}</version>
            </plugin>
        </plugins>
    </build>
</project>